{
  "package": "@hannasage/projection-ui",
  "version": "1.0.0-beta.0",
  "npmTag": "beta",
  "access": "public",
  "expectedFileCount": 71,
  "maxPackageBytes": 160000,
  "releaseBranch": "release/1.0.0",
  "remote": "origin",
  "workflow": {
    "file": ".github/workflows/publish.yml",
    "verifyJob": "verify",
    "publishJob": "publish",
    "verifier": "scripts/verify-release.mjs",
    "justified": {},
    "publishEnvironment": "npm-publish",
    "publishUses": [
      "actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
      "actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020",
      "actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093"
    ],
    "pins": [
      {
        "path": ".github/workflows/publish.yml",
        "sha256": "5c94d1edea78ba92efe3eb846dd7e1fcf0c3886502de9fc5df58ec55cfa852da"
      },
      {
        "path": "scripts/verify-release.mjs",
        "sha256": "180c939bdcde520bc364a557c21b0e4a7a680e2903bd14bf9717f0dc1b33cc40"
      },
      {
        "path": "scripts/publish-design-release.mjs",
        "sha256": "877307233987ed91f2724515ce441af9eba4bd5d1f0c6cb1b29c32df768782f3"
      },
      {
        "path": "scripts/release-channel.mjs",
        "sha256": "e238e3cfc18c7a71f7d22330054a7bd46c089b42c90cb7e581b2f2c408c32cd3"
      }
    ]
  },
  "gitTag": {
    "name": "v{version}",
    "message": "{version}"
  },
  "gates": [
    "tokens:check",
    "typecheck",
    "lint",
    "test",
    "build",
    "build:docs",
    "test:docs",
    "test:artifact"
  ],
  "ciOnlyGates": [
    {
      "name": "playwright-install",
      "command": "npx playwright install --with-deps chromium",
      "reason": "needs a browser (Playwright Chromium), which the release script does not install"
    },
    {
      "name": "test:storybook",
      "reason": "renders the stories in a browser"
    },
    {
      "name": "test:storybook-tools",
      "reason": "checks the Storybook tools in a browser"
    },
    {
      "name": "test:docs-themes",
      "reason": "renders the docs themes in a browser"
    }
  ],
  "designKit": {
    "dir": "docs-site/out/downloads",
    "name": "projection-ui-design-{version}.zip",
    "metadata": "design-package.json",
    "entries": [
      "LICENSE",
      "README.md",
      "design-manifest.json",
      "plugin/code.js",
      "plugin/manifest.template.json",
      "source/figma-scene.json",
      "tokens.json"
    ],
    "scene": "design-package/figma-scene.json"
  },
  "docsEdition": {
    "module": "docs-site/lib/versions.mjs",
    "builtRelease": "docs-site/out/release.json",
    "builtVersions": "docs-site/out/docs-versions.json",
    "builtChangelog": "docs-site/out/changelog.md",
    "changelog": "CHANGELOG.md"
  },
  "retire": {
    "note": "The package owner already retired the alpha 0.2.0-next.2. On 2026-11-08 npm showed it deprecated and the next tag removed. The commands stay as the record. A person runs them only after verify passes. They do not touch latest, which stays on 0.1.5. Moving latest is a separate choice.",
    "commands": [
      [
        "npm",
        "deprecate",
        "@hannasage/projection-ui@0.2.0-next.2",
        "Renamed to the beta tag. Use 1.0.0-beta.0."
      ],
      [
        "npm",
        "dist-tag",
        "rm",
        "@hannasage/projection-ui",
        "next"
      ]
    ],
    "checks": [
      [
        "npm",
        "view",
        "@hannasage/projection-ui",
        "dist-tags",
        "--json"
      ],
      [
        "npm",
        "view",
        "@hannasage/projection-ui@0.2.0-next.2",
        "deprecated"
      ]
    ]
  },
  "claims": {
    "patterns": [
      "unpublished candidate",
      "unpublished `",
      "which is unpublished",
      "Not published yet",
      "Nothing is published",
      "projection-ui@next",
      "has only 0.1.x releases"
    ],
    "paths": [
      "README.md",
      "docs",
      "docs-site/app",
      "docs-site/components",
      "docs-site/lib"
    ],
    "skipFileNames": [
      "workflow-audit.md"
    ],
    "skipDirs": [
      "archive",
      "node_modules",
      ".next",
      "out"
    ],
    "skipDirsReason": "node_modules, .next, and out are build output and not source. archive holds the preserved 0.1.5 documentation, whose statements describe that old release and stay as they were."
  }
}
