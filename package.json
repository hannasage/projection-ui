{
  "name": "@hannasage/projection-ui",
  "version": "0.2.0-next.1",
  "description": "Dark-first React component library and design token system. Consumer-configurable theming via ThemeProvider \u2014 no hardcoded themes.",
  "author": "Hanna Sage",
  "license": "MIT",
  "homepage": "https://docs.projectionui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hannasage/projection-ui.git"
  },
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "dark-mode",
    "theming",
    "recharts",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/src/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./charts": {
      "types": "./dist/src/charts.d.ts",
      "import": "./dist/charts.js",
      "require": "./dist/charts.cjs"
    },
    "./sortable": {
      "types": "./dist/src/sortable.d.ts",
      "import": "./dist/sortable.js",
      "require": "./dist/sortable.cjs"
    },
    "./toast": {
      "types": "./dist/src/toast.d.ts",
      "import": "./dist/toast.js",
      "require": "./dist/toast.cjs"
    },
    "./foundations": {
      "types": "./dist/src/foundations.d.ts",
      "import": "./dist/foundations.js",
      "require": "./dist/foundations.cjs"
    },
    "./tokens": "./dist/tokens/theme.css",
    "./styles": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/tokens/scoped.css"
    },
    "./reset": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/tokens/reset.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "node scripts/build-storybook.mjs --dev",
    "build": "vite build",
    "build:storybook": "node scripts/build-storybook.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "lint": "eslint src .storybook stories",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "tokens": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "test:storybook": "node scripts/test-storybook.mjs",
    "test:docs": "node scripts/test-docs.mjs",
    "test:artifact": "node scripts/test-release-artifact.mjs"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@storybook/addon-docs": "^8.6.12",
    "@storybook/blocks": "^8.6.12",
    "@storybook/react-vite": "^8.6.12",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "4.14.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "next": "16.4.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "storybook": "^8.6.18",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^3.9.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "recharts": "^3.8.1",
    "zustand": "^5.0.13",
    "react-is": "^19.2.6"
  }
}
