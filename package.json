{
  "name": "@hannasage/projection-ui",
  "version": "0.1.3",
  "description": "Dark-first React component library and design token system. Consumer-configurable theming via ThemeProvider — no hardcoded themes.",
  "author": "Hanna Sage",
  "license": "MIT",
  "homepage": "https://github.com/hannasage/projection-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hannasage/projection-ui.git"
  },
  "keywords": ["react", "component-library", "design-system", "dark-mode", "theming", "recharts", "typescript"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/src/index.d.ts"
    },
    "./tokens": "./dist/tokens/theme.css"
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build",
    "build:storybook": "storybook build",
    "lint": "eslint src",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@dnd-kit/core": ">=6.0.0",
    "@dnd-kit/sortable": ">=10.0.0",
    "@dnd-kit/utilities": ">=3.2.2",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "recharts": ">=3.0.0",
    "zustand": ">=5.0.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^8.6.12",
    "@storybook/blocks": "^8.6.12",
    "@storybook/react-vite": "^8.6.12",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-is": "^19.2.6",
    "recharts": "^3.8.1",
    "storybook": "^8.6.18",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^3.9.1",
    "zustand": "^5.0.13"
  }
}
